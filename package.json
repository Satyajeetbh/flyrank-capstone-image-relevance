{
  "name": "flyrank-capstone-image-relevance",
  "version": "1.0.0",
  "description": "Foundation for the FlyRank AI image understanding and content matching engine",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "tsc --pretty",
    "typecheck": "tsc --noEmit --pretty",
    "verify:db": "npm run build && node scripts/verify-database.mjs",
    "verify:repositories": "npm run build && node scripts/verify-repositories.mjs",
    "test:integration": "npm run build && node --test tests/integration/embeddings.test.mjs",
    "verify:embeddings": "npm run test:integration",
    "test:unit": "npm run build && node --test tests/unit/mismatch-guard.test.mjs tests/unit/openai-vision.test.mjs tests/unit/openai-embeddings.test.mjs"
  },
  "keywords": [
    "typescript",
    "image-relevance"
  ],
  "author": "FlyRank",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "openai": "^7.9.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
