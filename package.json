{
  "name": "flyrank-capstone-image-relevance",
  "version": "1.0.0",
  "description": "Foundation for the FlyRank AI image understanding and content matching engine",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc --pretty",
    "typecheck": "tsc --noEmit --pretty",
    "verify:db": "npm run build && node --env-file=.env scripts/verify-database.mjs",
    "verify:redis": "npm run build && node --env-file=.env scripts/verify-redis.mjs",
    "test:integration:queue": "npm run build && node --env-file=.env --test --test-concurrency=1 tests/integration/image-processing-queue.test.mjs",
    "test:integration:image-processing-jobs": "npm run build && node --env-file=.env --test --test-concurrency=1 tests/integration/image-processing-jobs.test.mjs",
    "test:integration:image-processing-worker": "npm run build && node --env-file=.env scripts/run-integration-test.mjs tests/integration/image-processing-worker.test.mjs",
    "verify:repositories": "npm run build && node --env-file=.env scripts/verify-repositories.mjs",
    "test:integration": "npm run build && node --env-file=.env scripts/run-isolated-integration.mjs",
    "test:integration:usage": "npm run build && node --env-file=.env --test --test-concurrency=1 tests/integration/ai-usage.test.mjs",
    "test:integration:jobs": "npm run build && node --env-file=.env --test --test-concurrency=1 tests/integration/jobs.test.mjs",
    "test:integration:raw": "node --env-file=.env --test --test-concurrency=1 tests/integration/embeddings.test.mjs tests/integration/semantic-image-retrieval.test.mjs tests/integration/matching-workflow.test.mjs tests/integration/suggestion-review.test.mjs",
    "verify:embeddings": "npm run test:integration",
    "test:evaluation": "npm run build && node --test tests/evaluation/retrieval-evaluation.test.mjs",
    "evaluate:retrieval": "npm run build && node --env-file=.env scripts/evaluate-retrieval.mjs",
    "evaluate:retrieval:calibrate": "npm run build && node --env-file=.env scripts/evaluate-retrieval.mjs --calibrate",
    "test:unit": "npm run build && node --test tests/unit/mismatch-guard.test.mjs tests/unit/openai-vision.test.mjs tests/unit/openai-embeddings.test.mjs tests/unit/gemini-embeddings.test.mjs tests/unit/ai-usage.test.mjs tests/unit/ai-budget.test.mjs",
    "test:unit:job-errors": "npm run build && node --test tests/unit/job-errors.test.mjs",
    "worker:image-processing": "npm run build && node --env-file=.env dist/workers/start-image-processing-worker.js",
    "test:integration:image-processing-retry": "npm run build && node --env-file=.env scripts/run-integration-test.mjs tests/integration/image-processing-retry.test.mjs",
    "test:integration:image-ingestion": "npm run build && node --env-file=.env --test --test-concurrency=1 tests/integration/image-ingestion.test.mjs"
  },
  "keywords": [
    "typescript",
    "image-relevance"
  ],
  "author": "FlyRank",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "bullmq": "^6.3.4",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "openai": "^7.9.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
